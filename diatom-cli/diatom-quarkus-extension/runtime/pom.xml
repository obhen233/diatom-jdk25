<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.obhen233</groupId>
        <artifactId>diatom-quarkus-extension</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>diatom-quarkus-extension-runtime</artifactId>

    <name>Diatom Quarkus Extension Runtime</name>
    <description>Diatom CLI - Quarkus runtime (Gateway/Worker/Child/Adapter runtime logic, depends on diatom-core)</description>

    <dependencies>
        <!-- Diatom core kernel (runtime-agnostic) -->
        <dependency>
            <groupId>com.github.obhen233</groupId>
            <artifactId>diatom-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Diatom adapter (AgentAdapter SPI + WorkerRegistrationClient + worker model records) -->
        <dependency>
            <groupId>com.github.obhen233</groupId>
            <artifactId>diatom-adapter-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Quarkus core + CDI/Arc + HTTP (Vert.x) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-vertx-http</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <!-- IDE Terminal WebSocket (Phase 4: quarkus-websockets-next) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-websockets-next</artifactId>
        </dependency>
        <!-- Cloud 注册中心（Phase 5: SmallRye Stork 服务发现/注册） -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-stork</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- SmallRye Config lazily generates ConfigMapping impls via ASM (test-time only) -->
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
